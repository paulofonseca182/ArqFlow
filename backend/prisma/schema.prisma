generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Client {
  id        String   @id @default(cuid())
  name      String
  status    String   @default("NEW_CONTACT")
  phone     String?
  whatsapp  String?
  email     String?  @unique
  cpfCnpj   String?
  address   String?
  city      String?
  state     String?
  source    String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projects      Project[]
  budgets       Budget[]
  payments      Payment[]
  visits        Visit[]
  expenses      Expense[]
  cashMovements CashMovement[]

  @@index([name])
  @@index([status])
}

model Project {
  id                   String    @id @default(cuid())
  clientId             String
  budgetId             String?   @unique
  name                 String
  type                 String
  workAddress          String?
  area                 Decimal?
  contractedAmount     Decimal?
  startsAt             DateTime?
  expectedDeliveryDate DateTime?
  status               String    @default("CONTRACT_IN_PROGRESS")
  description          String?
  notes                String?
  internalNotes        String?
  origin               String    @default("LEGACY")
  manualReason         String?
  approvedAt           DateTime?
  convertedAt          DateTime?
  pinned               Boolean   @default(false)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  client          Client         @relation(fields: [clientId], references: [id], onDelete: Restrict)
  budget          Budget?        @relation("ProjectOriginBudget", fields: [budgetId], references: [id], onDelete: SetNull)
  convertedBudget Budget?        @relation("BudgetConvertedProject")
  steps           ProjectStep[]
  budgets         Budget[]       @relation("ProjectBudgets")
  payments        Payment[]
  tasks           Task[]
  visits          Visit[]
  expenses        Expense[]
  cashMovements   CashMovement[]

  @@index([clientId])
  @@index([budgetId])
  @@index([origin])
  @@index([status])
  @@index([type])
}

model ProjectStep {
  id          String    @id @default(cuid())
  projectId   String
  name        String
  description String?
  sortOrder   Int
  startsAt    DateTime?
  dueDate     DateTime?
  completedAt DateTime?
  status      String    @default("PENDING")
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, sortOrder])
  @@index([projectId])
  @@index([status])
}

model Budget {
  id                 String    @id @default(cuid())
  clientId           String
  projectId          String?
  convertedProjectId String?   @unique
  title              String
  serviceType        String
  description        String?
  totalAmount        Decimal   @default(0)
  discount           Decimal   @default(0)
  finalAmount        Decimal   @default(0)
  paymentMethod      String?
  expiresAt          DateTime?
  status             String    @default("DRAFT")
  approvedAt         DateTime?
  convertedAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  client            Client       @relation(fields: [clientId], references: [id], onDelete: Restrict)
  project           Project?     @relation("ProjectBudgets", fields: [projectId], references: [id], onDelete: SetNull)
  convertedProject  Project?     @relation("BudgetConvertedProject", fields: [convertedProjectId], references: [id], onDelete: SetNull)
  originatedProject Project?     @relation("ProjectOriginBudget")
  items             BudgetItem[]

  @@index([clientId])
  @@index([projectId])
  @@index([convertedProjectId])
  @@index([status])
}

model BudgetItem {
  id          String  @id @default(cuid())
  budgetId    String
  description String
  quantity    Decimal
  unitAmount  Decimal
  totalAmount Decimal

  budget Budget @relation(fields: [budgetId], references: [id], onDelete: Cascade)

  @@index([budgetId])
}

model Payment {
  id            String    @id @default(cuid())
  projectId     String
  clientId      String
  visitId       String?   @unique
  categoryId    String?
  cashAccountId String?
  source        String    @default("PROJECT")
  description   String
  amount        Decimal
  paidAmount    Decimal   @default(0)
  installment   Int?
  dueDate       DateTime
  paidAt        DateTime?
  paymentMethod String?
  status        String    @default("RECEIVABLE")
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  project      Project            @relation(fields: [projectId], references: [id], onDelete: Restrict)
  client       Client             @relation(fields: [clientId], references: [id], onDelete: Restrict)
  visit        Visit?             @relation(fields: [visitId], references: [id], onDelete: Restrict)
  category     FinancialCategory? @relation("PaymentCategory", fields: [categoryId], references: [id], onDelete: SetNull)
  cashAccount  CashAccount?       @relation("PaymentCashAccount", fields: [cashAccountId], references: [id], onDelete: SetNull)
  cashMovement CashMovement?

  @@index([projectId])
  @@index([clientId])
  @@index([visitId])
  @@index([categoryId])
  @@index([cashAccountId])
  @@index([source])
  @@index([status])
  @@index([dueDate])
}

model Expense {
  id                String    @id @default(cuid())
  parentExpenseId   String?
  projectId         String?
  clientId          String?
  categoryId        String?
  cashAccountId     String?
  entryType         String    @default("SINGLE")
  classification    String    @default("OPERATIONAL_EXPENSE")
  description       String
  supplier          String?
  costCenter        String?
  amount            Decimal
  dueDate           DateTime?
  purchaseDate      DateTime?
  paidAmount        Decimal   @default(0)
  paidAt            DateTime?
  paymentMethod     String?
  status            String    @default("PENDING")
  installmentNumber Int?
  installmentCount  Int?
  recurring         Boolean   @default(false)
  notes             String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  parent        Expense?           @relation("ExpenseInstallments", fields: [parentExpenseId], references: [id], onDelete: SetNull)
  installments  Expense[]          @relation("ExpenseInstallments")
  project       Project?           @relation(fields: [projectId], references: [id], onDelete: SetNull)
  client        Client?            @relation(fields: [clientId], references: [id], onDelete: SetNull)
  category      FinancialCategory? @relation("ExpenseCategory", fields: [categoryId], references: [id], onDelete: SetNull)
  cashAccount   CashAccount?       @relation("ExpenseCashAccount", fields: [cashAccountId], references: [id], onDelete: SetNull)
  payments      ExpensePayment[]
  cashMovements CashMovement[]

  @@index([parentExpenseId])
  @@index([projectId])
  @@index([clientId])
  @@index([categoryId])
  @@index([cashAccountId])
  @@index([entryType])
  @@index([classification])
  @@index([status])
  @@index([dueDate])
}

model ExpensePayment {
  id            String   @id @default(cuid())
  expenseId     String
  cashAccountId String?
  amount        Decimal
  paidAt        DateTime
  paymentMethod String?
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  expense      Expense       @relation(fields: [expenseId], references: [id], onDelete: Restrict)
  cashMovement CashMovement?
  cashAccount  CashAccount?  @relation(fields: [cashAccountId], references: [id], onDelete: SetNull)

  @@index([expenseId])
  @@index([cashAccountId])
  @@index([paidAt])
}

model CashMovement {
  id               String   @id @default(cuid())
  paymentId        String?  @unique
  expenseId        String?
  expensePaymentId String?  @unique
  visitId          String?
  clientId         String?
  projectId        String?
  categoryId       String?
  cashAccountId    String?
  type             String
  date             DateTime
  description      String
  amount           Decimal
  paymentMethod    String?
  origin           String
  referenceId      String?
  notes            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  payment        Payment?           @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  expense        Expense?           @relation(fields: [expenseId], references: [id], onDelete: SetNull)
  expensePayment ExpensePayment?    @relation(fields: [expensePaymentId], references: [id], onDelete: SetNull)
  visit          Visit?             @relation(fields: [visitId], references: [id], onDelete: SetNull)
  client         Client?            @relation(fields: [clientId], references: [id], onDelete: SetNull)
  project        Project?           @relation(fields: [projectId], references: [id], onDelete: SetNull)
  category       FinancialCategory? @relation("CashMovementCategory", fields: [categoryId], references: [id], onDelete: SetNull)
  cashAccount    CashAccount?       @relation(fields: [cashAccountId], references: [id], onDelete: SetNull)

  @@index([type])
  @@index([date])
  @@index([origin])
  @@index([referenceId])
  @@index([clientId])
  @@index([projectId])
  @@index([categoryId])
  @@index([cashAccountId])
  @@index([expenseId])
}

model FinancialCategory {
  id         String   @id @default(cuid())
  name       String
  type       String
  costCenter String?
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  payments      Payment[]      @relation("PaymentCategory")
  expenses      Expense[]      @relation("ExpenseCategory")
  cashMovements CashMovement[] @relation("CashMovementCategory")

  @@unique([name, type])
  @@index([type])
  @@index([active])
}

model CashAccount {
  id             String   @id @default(cuid())
  name           String   @unique
  type           String   @default("CASH")
  openingBalance Decimal  @default(0)
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  payments        Payment[]        @relation("PaymentCashAccount")
  expenses        Expense[]        @relation("ExpenseCashAccount")
  expensePayments ExpensePayment[]
  cashMovements   CashMovement[]

  @@index([type])
  @@index([active])
}

model Task {
  id          String    @id @default(cuid())
  projectId   String?
  title       String
  description String?
  assignee    String?
  dueDate     DateTime?
  priority    String    @default("MEDIUM")
  status      String    @default("PENDING")
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([status])
  @@index([priority])
}

model Visit {
  id        String   @id @default(cuid())
  clientId  String
  projectId String?
  type      String
  date      DateTime
  time      String?
  address   String?
  amount    Decimal?
  status    String   @default("SCHEDULED")
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  client        Client         @relation(fields: [clientId], references: [id], onDelete: Restrict)
  project       Project?       @relation(fields: [projectId], references: [id], onDelete: SetNull)
  payment       Payment?
  cashMovements CashMovement[]

  @@index([clientId])
  @@index([projectId])
  @@index([status])
  @@index([date])
}
